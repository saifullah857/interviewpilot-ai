# Copy to apps/api/.env and edit. Never commit .env.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-one
# PostgreSQL (see docs/SETUP_WINDOWS.md). SQLite fallback: sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://interviewpilot:YOUR_DB_PASSWORD@localhost:5432/interviewpilot
CORS_ORIGINS=http://localhost:5173

# Where uploaded resumes are stored (private folder, never served directly)
STORAGE_PATH=./storage_private
MAX_UPLOAD_MB=5

# AI provider. Leave GROQ_API_KEY empty to use the app without AI analysis.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Pick a model from https://console.groq.com/docs/models (check it supports JSON output)
LLM_MODEL_PRIMARY=
# Optional: tried once if the primary model is rate limited or down (Groq limits are per model). Leave as is or clear it.
LLM_MODEL_FALLBACK=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT=4096
# Only used by gpt-oss models: low = fast, medium/high = slower and uses many more tokens
LLM_REASONING_EFFORT=low

# Company research (any signed-in user can start it from a company page). Leave TAVILY_API_KEY empty to run without live research.
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Code runner (see docs/SANDBOX_DESIGN.md). "local" (recommended) runs your code on this computer inside the API, no extra window.
# "http" calls the separate runner service (Linux/WSL2 bubblewrap). "mock" runs NO code.
RUNNER_MODE=local
RUNNER_URL=http://127.0.0.1:8100
# Same value as RUNNER_SHARED_SECRET in services/sandbox-runner (at least 32 characters). Needed only when RUNNER_MODE=http
RUNNER_SHARED_SECRET=

# Voice interview (Phase 8): optional, defaults shown
# INTERVIEWS_PER_HOUR=4
# INTERVIEW_AI_CALLS_PER_HOUR=200
# INTERVIEW_IDLE_MINUTES=30
# INTERVIEW_PURGE_HOURS=24

# Reports (Phase 9): optional, defaults shown
# REPORTS_PER_HOUR=10
# MAX_REPORTS_PER_USER=100
