# Same value as RUNNER_SHARED_SECRET in apps/api/.env (at least 32 characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
RUNNER_SHARED_SECRET=
# bwrap = REAL sandboxed execution (Linux or WSL2, needs bubblewrap, run as a normal user). mock = executes nothing.
# scripts/start-runner.sh sets this for you.
RUNNER_BACKEND=bwrap
# Optional: RUNNER_MAX_PARALLEL=2  RUNNER_PYTHON=/usr/bin/python3  RUNNER_BWRAP=/usr/bin/bwrap
